DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bookstore_user:bookstore_password@localhost:5432/bookstore
DB_NAME=bookstore
DB_USER=bookstore_user
DB_PASSWORD=bookstore_password
